# Supabase project settings (Project Settings → API). The anon key is safe to expose in the browser;
# row level security in supabase/migrations keeps each person's data private.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional: shown on the About page for rights holders
VITE_CONTACT_EMAIL=
